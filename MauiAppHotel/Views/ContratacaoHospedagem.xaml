<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout VerticalOptions="Center"
                         Padding="10">
        <Label Text="Cálculo da Diária"
               FontFamily="Kalam"
               FontSize="50"
               TextColor="{StaticResource Primary}"/>

        <Frame Padding="15" Margin="5"
               BackgroundColor="WhiteSmoke"
               BorderColor="{StaticResource Gray500}">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:"
                           TextColor="Black"/>

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0" Maximum="10"
                             Increment="1"
                             BackgroundColor="{StaticResource Primary}"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:"
                           TextColor="Black"/>

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0" Maximum="10"
                             Increment="1"
                             BackgroundColor="{StaticResource Primary}"/>

                </Grid>

                <Label Text="Escolha sua Suíte" 
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       FontSize="19"/>

                <Label Text="Selecione sua Acomodação"
                       TextColor="Black"/>
                <Picker x:Name="pck_quarto"
                        TextColor="WhiteSmoke"
                        FontAttributes="Bold"
                        ItemDisplayBinding="{Binding Descricao}"
                        BackgroundColor="{StaticResource SecondaryDarkText}"/>

                <Frame Padding="10"
                       Margin="10"
                       BackgroundColor="White"
                       BorderColor="{StaticResource Gray500}">
                    <VerticalStackLayout>
                        
                        <Label Text="Período da Estadia"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"/>

                        <HorizontalStackLayout Margin="20,5,0,0">
                            <Label Text="Check-in:"
                                   TextColor="Black"/>

                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy"
                                        TextColor="Black"
                                        BackgroundColor="{StaticResource Gray100}"
                                        Margin="5"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="20,5,0,0">
                            <Label Text="Check-out:"
                                   TextColor="Black"/>

                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy"
                                        TextColor="Black"
                                        BackgroundColor="{StaticResource Gray100}"
                                        Margin="5"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
                       
            </VerticalStackLayout>
        </Frame>

        <Button Text="Avançar"
                Margin="5"
                TextColor="{StaticResource Gray100}"
                FontAttributes="Bold"
                Background="{StaticResource Primary}"
                Clicked="Avancar_Cliked"/>
        
        <Button Text="Sobre"
                Margin="5"
                TextColor="{StaticResource Gray100}"
                FontAttributes="Bold"
                Background="{StaticResource Primary}"
                Clicked="Sobre_Clicked"/>
        

    </VerticalStackLayout>
</ContentPage>