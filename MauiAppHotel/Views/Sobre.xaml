<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout Padding="15"
                         VerticalOptions="Center"
                         Spacing="20">

        <Label Text="Sobre"
               FontSize="40"
               FontAttributes="Bold"
               FontFamily="Kalam"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center"/>

        <Frame BackgroundColor="{StaticResource Gray200}"
               CornerRadius="15"
               Padding="15">

            <VerticalStackLayout Spacing="10">
                
                <Label Text="Desenvolvido por Arwin Tuco"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"/>

                <Label Text="Aplicativo de hospedagem desenvolvido em .NET MAUI."
                       TextColor="{StaticResource Black}"
                       FontSize="15"/>


                <Label Text="Ano de desenvolvimento: 2026"
                       FontSize="15"
                       TextColor="{StaticResource Primary}"/>

            </VerticalStackLayout>

        </Frame>

        <Button Text="Voltar"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource Gray100}"
                FontAttributes="Bold"
                Clicked="Button_Clicked"/>

    </VerticalStackLayout>

</ContentPage>